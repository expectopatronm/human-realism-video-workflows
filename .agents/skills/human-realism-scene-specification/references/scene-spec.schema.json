{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/human-realism-scene-specification/scene-spec.schema.json",
  "title": "Human Realism Scene Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "references", "subjects", "intent", "global_rules", "components", "assumptions", "unresolved_conflicts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scene_id": {"$ref": "#/$defs/id"},
    "references": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "observation", "confidence"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "source": {"type": "string", "minLength": 1},
          "observation": {"type": "string", "minLength": 1},
          "confidence": {"$ref": "#/$defs/confidence"}
        }
      }
    },
    "subjects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "reference_ids", "identity_constraints", "appearance_changes"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "reference_ids": {"$ref": "#/$defs/idList"},
          "identity_constraints": {"$ref": "#/$defs/textList"},
          "appearance_changes": {"$ref": "#/$defs/textList"}
        }
      }
    },
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["request", "setting", "camera", "duration", "initial_state", "beats", "final_state"],
      "properties": {
        "request": {"type": "string", "minLength": 1},
        "setting": {"$ref": "#/$defs/nullableText"},
        "camera": {"$ref": "#/$defs/nullableText"},
        "duration": {"$ref": "#/$defs/nullableText"},
        "initial_state": {"type": "string", "minLength": 1},
        "beats": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "action", "subject_ids"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "action": {"type": "string", "minLength": 1},
              "subject_ids": {"$ref": "#/$defs/idList"}
            }
          }
        },
        "final_state": {"type": "string", "minLength": 1}
      }
    },
    "global_rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "constraint"],
        "properties": {
          "id": {"type": "string", "pattern": "^G[0-9]{2}$"},
          "constraint": {"type": "string", "minLength": 1}
        }
      }
    },
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["subject_id", "component_id", "name", "applicability", "priority", "reference_observation", "scene_intent", "appearance_preservation", "primary_motion", "secondary_motion_and_physics", "deformation_and_interaction", "temporal_continuity", "negative_constraints", "traceability"],
        "properties": {
          "subject_id": {"$ref": "#/$defs/id"},
          "component_id": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}$"},
          "name": {"type": "string", "minLength": 1},
          "applicability": {"enum": ["active", "visible-static", "occluded", "outside-frame", "n/a", "uncertain"]},
          "priority": {"enum": ["critical", "high", "normal", "low"]},
          "reference_observation": {
            "type": "object", "additionalProperties": false,
            "required": ["observed", "unknown", "reference_ids", "confidence"],
            "properties": {
              "observed": {"$ref": "#/$defs/textList"},
              "unknown": {"$ref": "#/$defs/textList"},
              "reference_ids": {"$ref": "#/$defs/idList"},
              "confidence": {"$ref": "#/$defs/confidence"}
            }
          },
          "scene_intent": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "initial_state", "final_state"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "initial_state": {"$ref": "#/$defs/nullableText"},
              "final_state": {"$ref": "#/$defs/nullableText"}
            }
          },
          "appearance_preservation": {
            "type": "object", "additionalProperties": false,
            "required": ["invariants", "allowed_changes"],
            "properties": {
              "invariants": {"$ref": "#/$defs/textList"},
              "allowed_changes": {"$ref": "#/$defs/textList"}
            }
          },
          "primary_motion": {"$ref": "#/$defs/motion"},
          "secondary_motion_and_physics": {
            "type": "object", "additionalProperties": false,
            "required": ["required", "drivers", "behavior"],
            "properties": {
              "required": {"$ref": "#/$defs/motionRequired"},
              "drivers": {"$ref": "#/$defs/textList"},
              "behavior": {"$ref": "#/$defs/textList"}
            }
          },
          "deformation_and_interaction": {
            "type": "object", "additionalProperties": false,
            "required": ["requirements", "contacts", "occlusion"],
            "properties": {
              "requirements": {"$ref": "#/$defs/textList"},
              "contacts": {"$ref": "#/$defs/textList"},
              "occlusion": {"$ref": "#/$defs/nullableText"}
            }
          },
          "temporal_continuity": {
            "type": "object", "additionalProperties": false,
            "required": ["invariants", "allowed_changes", "occlusion_recovery"],
            "properties": {
              "invariants": {"$ref": "#/$defs/textList"},
              "allowed_changes": {"$ref": "#/$defs/textList"},
              "occlusion_recovery": {"$ref": "#/$defs/nullableText"}
            }
          },
          "negative_constraints": {"$ref": "#/$defs/textList"},
          "traceability": {
            "type": "object", "additionalProperties": false,
            "required": ["global_rule_ids", "reference_ids", "assumptions", "unresolved_conflicts"],
            "properties": {
              "global_rule_ids": {"$ref": "#/$defs/idList"},
              "reference_ids": {"$ref": "#/$defs/idList"},
              "assumptions": {"$ref": "#/$defs/textList"},
              "unresolved_conflicts": {"$ref": "#/$defs/textList"}
            }
          }
        }
      }
    },
    "assumptions": {"$ref": "#/$defs/textList"},
    "unresolved_conflicts": {"$ref": "#/$defs/textList"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "idList": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "textList": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nullableText": {"type": ["string", "null"]},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "motionRequired": {"enum": ["yes", "no", "conditional"]},
    "motion": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "description", "timing", "constraints"],
      "properties": {
        "required": {"$ref": "#/$defs/motionRequired"},
        "description": {"type": "string", "minLength": 1},
        "timing": {"$ref": "#/$defs/nullableText"},
        "constraints": {"$ref": "#/$defs/textList"}
      }
    }
  }
}
